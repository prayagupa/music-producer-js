# Backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Ollama (default LLM)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
LLM_TIMEOUT_SECONDS=25
LLM_PROVIDER=ollama
# Set to mock for local testing without Ollama: LLM_PROVIDER=mock

# OpenAI fallback (optional)
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Eval
EVAL_MOCK_LLM=false
BACKEND_URL=http://localhost:8000
